// DBML: 04_Relating Records with Joins.dbml
// Database: relationships

Table users {
  id       serial [pk, increment]
  username varchar(50) [not null]
}

Table photos {
  id      serial [pk, increment]
  url     varchar(200)
  user_id integer [ref: > users.id]
}

Table comments {
  id       serial [pk, increment]
  contents varchar(240)
  user_id  integer [ref: > users.id]
  photo_id integer [ref: > photos.id]
}

Table authors {
  id   serial [pk, increment]
  name varchar(100)
}

Table books {
  id        serial [pk, increment]
  title     varchar(200)
  author_id integer [ref: > authors.id]
}
