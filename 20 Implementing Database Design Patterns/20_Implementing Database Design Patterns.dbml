// DBML: 20_Implementing Database Design Patterns.dbml
// Database: instagram

Table users {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  username   varchar(30) [not null]
  bio        varchar(400)
  avatar     varchar(200)
  phone      varchar(25)
  email      varchar(40)
  password   varchar(50)
  status     varchar(15)

  note: 'CHECK (COALESCE(phone, email) IS NOT NULL)'
}

Table posts {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  url        varchar(200) [not null]
  caption    varchar(240)
  lat        real
  lng        real
  user_id    integer [not null, ref: > users.id]
}

Table comments {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  contents   varchar(240) [not null]
  user_id    integer [not null, ref: > users.id]
  post_id    integer [not null, ref: > posts.id]
}

Table likes {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  user_id    integer [not null, ref: > users.id]
  post_id    integer [ref: > posts.id]
  comment_id integer [ref: > comments.id]

  note: 'CHECK: exactly one of post_id or comment_id must be set'
  indexes {
    (user_id, post_id, comment_id) [unique]
  }
}

Table photo_tags {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  updated_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  user_id    integer [not null, ref: > users.id]
  post_id    integer [not null, ref: > posts.id]
  x          integer [not null]
  y          integer [not null]

  indexes {
    (user_id, post_id) [unique]
  }
}

Table caption_tags {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  user_id    integer [not null, ref: > users.id]
  post_id    integer [not null, ref: > posts.id]

  indexes {
    (user_id, post_id) [unique]
  }
}

Table hashtags {
  id         serial [pk, increment]
  created_at "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  title      varchar(20) [not null, unique]
}

Table hashtags_posts {
  id         serial [pk, increment]
  hashtag_id integer [not null, ref: > hashtags.id]
  post_id    integer [not null, ref: > posts.id]

  indexes {
    (hashtag_id, post_id) [unique]
  }
}

Table followers {
  id          serial [pk, increment]
  created_at  "timestamp with time zone" [default: `CURRENT_TIMESTAMP`]
  leader_id   integer [not null, ref: > users.id]
  follower_id integer [not null, ref: > users.id]

  indexes {
    (leader_id, follower_id) [unique]
  }
}
